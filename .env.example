# Local development defaults. Change all credentials and secrets for production.
NODE_ENV=development
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=local-development-secret-change-this-value
MAX_ACTIVE_SESSIONS=8
SESSION_DURATION=90
COOLDOWN_DURATION=180
MAX_UPLOAD_MB=25

# Relative paths resolve from the project directory. Use persistent absolute paths in production.
DATABASE_PATH=./database/classhub.db
UPLOAD_DIR=./uploads

# Set to false for a public informational showcase that should not expose classroom routes.
CLASSROOM_ENABLED=true

# For reverse-proxy deployments, set TRUST_PROXY=1 and configure the public canonical origin.
# TRUST_PROXY=1
# PUBLIC_BASE_URL=https://classhub.example.com
